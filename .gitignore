# Build output
/target/
/dist/
*.egg-info/
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.whl
# The native module that maturin puts next to the Python sources of an editable install
*.so

# The two programs that `just wheel` and the CI copy into the package before they build the wheel
/python/netscenario/src/netscenario/_bin/

# Results of runs and spikes
/results/
/netscenario-results/
/spikes/out*/
/spikes/*/target/
*.pcap

# Editors and systems
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# Local working documents: instructions for the assistant and the working plan. They stay on the
# machine of the maintainer and nothing in the repository may refer to them.
/PLAN.md
/CLAUDE.md
/.claude/
